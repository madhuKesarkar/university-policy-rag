# --- Database (local Docker default; swap for Supabase/Neon connection string in production) ---
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=university_rag
DATABASE_URL=postgresql+psycopg://rag_admin:rag_password@localhost:5432/university_rag

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Embeddings / reranker (local, free — no key needed for the default models) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- LLM provider (pick ONE free-tier provider) ---
LLM_PROVIDER=groq              # groq | gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b   # smaller model = more free-tier daily-token headroom; check https://console.groq.com/docs/models for current options
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MIN_CONFIDENCE_SCORE=0.35       # below this rerank score, answer "I don't know" instead of guessing

# --- Tracing (Langfuse — self-hosted or cloud free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
