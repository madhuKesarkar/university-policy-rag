# Leave NEXT_PUBLIC_API_URL unset to use the /api/* rewrite in next.config.js (recommended —
# same-origin, no CORS needed). Only set it to call the backend directly, bypassing the proxy.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where next.config.js's rewrite proxies /api/* to. Point this at the deployed backend's URL
# in production.
BACKEND_URL=http://127.0.0.1:8000
